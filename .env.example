

# Azure configuration. DefaultAzureCredential uses Azure CLI locally and
# the configured workload/managed identity in CI.
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_RESOURCE_GROUP=optional-resource-group
AZURE_MANAGED_IDENTITY_CLIENT_ID=optional-managed-identity-client-id
# Optional legacy/exported settings file:
# AZURE_CREDENTIALS_FILE_PATH=/path/to/azure/settings.json

# GCP configuration
GCP_PROJECT_ID=your-gcp-project-id
# Prefer Application Default Credentials locally:
# gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional settings file containing project_id and service_account_key_path:
# GCP_CREDENTIALS_FILE_PATH=/path/to/gcp/settings.json
